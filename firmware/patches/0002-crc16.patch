-uint8_t SensorUart_Crc8(const char *s, int len)
+/* CRC-16 (다항식 0xA2EB = Koopman 표기 0xD175, 초기값 0xFFFF). 줄 끝 '*HHHH' 로 붙여 수신 쪽이 손상된 줄을 버릴 수 있게 한다 (2026-11 추가).
+ * 한 줄이 약 194자(약 1,550비트)라 8비트 CRC는 해밍 거리 2 구간이다 (0x07은 약 119비트까지만 HD=4, Koopman CRC 표).
+ * 0xD175 는 32,751비트까지 HD=4 (Koopman CRC 표). 라즈베리파이 Uart_stm.py 의 crc16() 과 같은 계산. */
+uint16_t SensorUart_Crc16(const char *s, int len)
 {
-  uint8_t crc = 0U;
+  uint16_t crc = 0xFFFFU;
   int i;
   int b;
 
   for (i = 0; i < len; i++)
   {
-    crc ^= (uint8_t)s[i];
+    crc ^= (uint16_t)((uint16_t)(uint8_t)s[i] << 8U);
     for (b = 0; b < 8; b++)
     {
-      if ((crc & 0x80U) != 0U)
+      if ((crc & 0x8000U) != 0U)
       {
-        crc = (uint8_t)((uint8_t)(crc << 1U) ^ 0x07U);
+        crc = (uint16_t)((uint16_t)(crc << 1U) ^ 0xA2EBU);
       }
       else
       {
-        crc = (uint8_t)(crc << 1U);
+        crc = (uint16_t)(crc << 1U);
       }
     }
   }
   return crc;
 }
 
-/* FormatSample 이 만든 "...\n" 을 "...*HH\n" 으로 바꾼다. 자리가 없으면 0 (보내지 않음). */
+/* FormatSample 이 만든 "...\n" 을 "...*HHHH\n" 으로 바꾼다. 자리가 없으면 0 (보내지 않음). */
 int SensorUart_AppendCrc(char *line, int len, int cap)
 {
-  uint8_t crc;
+  uint16_t crc;
 
-  if ((len <= 0) || (line[len - 1] != '\n') || (len + 3 >= cap))
+  if ((len <= 0) || (line[len - 1] != '\n') || (len + 5 >= cap))
   {
     return 0;
   }
   len--;                                   /* 줄바꿈을 잠시 뺀다 */
-  crc = SensorUart_Crc8(line, len);
-  len += snprintf(&line[len], (size_t)(cap - len), "*%02X\n", (unsigned int)crc);
+  crc = SensorUart_Crc16(line, len);
+  len += snprintf(&line[len], (size_t)(cap - len), "*%04X\n", (unsigned int)crc);
   return len;
 }
 
