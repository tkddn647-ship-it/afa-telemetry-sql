 # C 쪽과 같은 CRC
-check(u.crc8("123456789") == 0xF4, "CRC-8 표준 검사값 123456789 -> F4")
+# 다른 방식(다항식 나눗셈)으로 같은 CRC를 계산해 crc16() 과 비교: 구현 실수 확인용
+def crc16_by_division(text):
+    data = int.from_bytes(text.encode("ascii"), "big") ^ (0xFFFF << (8 * len(text) - 16))   # 초기값 0xFFFF = 앞 16비트 반전
+    rem, poly = data << 16, 0x1A2EB
+    for bit in range(rem.bit_length() - 1, 15, -1):
+        if rem >> bit & 1:
+            rem ^= poly << (bit - 16)
+    return rem
+check(all(u.crc16(t) == crc16_by_division(t) for t in ("123456789", good, "342412,8.82,-1.49")),
+      "CRC-16 을 다항식 나눗셈으로 따로 계산해도 같은 값")
+import random
+rnd = random.Random(1)
+missed = 0
+for _ in range(20000):                      # 무작위 1비트 손상은 전부 잡아야 함
+    b = bytearray(with_crc.split("*")[0].encode())
+    i = rnd.randrange(len(b)); b[i] ^= 1 << rnd.randrange(7)
+    missed += u.crc16(b.decode()) == u.crc16(with_crc.split("*")[0])
+check(missed == 0, "무작위 1비트 손상 20,000번 모두 CRC가 달라짐")
 if len(sys.argv) > 1:                                   # make_and_run.sh 가 C 시험이 만든 줄을 넘겨줌
     c_line = sys.argv[1]
     check(u.parse_line(c_line) is not None or u.last_reject_reason != "crc",
           f"C가 만든 줄의 CRC를 파이썬이 같은 값으로 검사 ({c_line.strip()})")
 
+# UART 줄 단계의 결함 주입: 로그에서 본 손상 모양을 무작위로 심고, 새 파서가 몇 개를 그대로 받아들이는지 센다
+kinds = {"글자 빠짐": 0, "글자 끼어듦": 0, "쉼표 빠짐": 0, "바이트 뒤바뀜": 0}
+passed = dict.fromkeys(kinds, 0)
+for t in range(40000):
+    k = list(kinds)[t % 4]
+    body, crc = with_crc.rsplit("*", 1)
+    b = list(body)
+    i = rnd.randrange(len(b))
+    if k == "글자 빠짐":
+        del b[i]
+    elif k == "글자 끼어듦":
+        b.insert(i, rnd.choice("0123456789"))
+    elif k == "쉼표 빠짐":
+        commas = [j for j, ch in enumerate(b) if ch == ","]
+        del b[rnd.choice(commas)]
+    else:
+        j = min(i + 1, len(b) - 1)
+        if b[i] == b[j]:
+            continue
+        b[i], b[j] = b[j], b[i]
+    kinds[k] += 1
+    passed[k] += u.parse_line("".join(b) + "*" + crc) is not None
+print("   UART 줄 결함 주입:", ", ".join(f"{k} {passed[k]}/{kinds[k]}개 통과" for k in kinds))
+check(sum(passed.values()) == 0, "로그에서 본 모양의 손상을 4만 번 심어도 받아들인 줄 0개")
+
 # 깨진 바이트는 조용히 지우지 않는다
 try:
     b"342412,4\xb4.4".decode("ascii", errors="strict")
