+++ b/device/tests/README.md
@@ -0,0 +1,13 @@
+# UART 전송 시험 (컴퓨터에서)
+
+```bash
+bash device/tests/make_and_run.sh
+```
+
+STM32 HAL을 흉내 낸 것으로 바꿔 끼우고 `uart4_tx.c`(전송 버퍼)와 `sensor_uart.c`의 CRC 함수, 라즈베리파이 `Uart_stm.py`의 `parse_line`을 시험한다.
+실차·실제 UART 시험은 아니다. 고친 이유와 근거는 afa-telemetry-sql 분석 (2026-08-11 로그, 규칙 v2) 참고:
+
+- 버퍼가 차면 줄 앞부분만 넣고 멈춰, 반쪽 줄이 다음 줄과 붙었다 → 한 줄을 통째로 넣거나 버림
+- 줄에 검사값이 없어 손상된 줄을 알아낼 수 없었다 → 줄 끝 `*HH` (CRC-8)
+- 수신 쪽이 깨진 바이트를 지우고(`errors="ignore"`), 칸 수가 안 맞으면 0으로 채우거나 잘라서 저장했다 → 버리고 이유를 센다
+- 버린 줄 수를 세기만 하고 보내지 않았다 → HB 줄 뒤에 두 칸 추가
diff --git a/device/tests/make_and_run.sh b/device/tests/make_and_run.sh
new file mode 100644
index 0000000..b1dfb73
--- /dev/null
+++ b/device/tests/make_and_run.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# 컴퓨터(호스트)에서 UART 전송 코드를 시험한다. STM32 HAL은 흉내 낸 것(stub)으로 바꿔 끼운다.
+# 사용: bash device/tests/make_and_run.sh
+set -e
+cd "$(dirname "$0")"
+SRC=../ECU_test/Core/Src
+INC=../ECU_test/Core/Inc
+mkdir -p build/stub
+cat > build/stub/usart.h <<'H'
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+typedef struct { void *Instance; } UART_HandleTypeDef;
+#define UART4 ((void *)4)
+#define HAL_OK 0
+extern UART_HandleTypeDef huart4;
+int HAL_UART_Transmit_DMA(UART_HandleTypeDef *h, uint8_t *d, uint16_t n);
+int HAL_UART_AbortTransmit(UART_HandleTypeDef *h);
+static inline void __disable_irq(void) {}
+static inline void __enable_irq(void) {}
+H
+# sensor_uart.c 에서 CRC 두 함수만 떼어 온다 (나머지는 하드웨어 의존)
+python3 - "$SRC/sensor_uart.c" > build/crc_funcs.c <<'P'
+import re, sys
+s = open(sys.argv[1], encoding="utf-8").read()
+out = ["#include <stdio.h>", "#include <stdint.h>"]
+for name in ("uint8_t SensorUart_Crc8(", "int SensorUart_AppendCrc("):
+    i = s.index(name); j = s.index("\n}\n", i) + 3
+    out.append(s[i:j])
+print("\n".join(out))
+P
+gcc -std=c99 -Wall -Wextra -Werror -I build/stub -I "$INC" -o build/test_uart \
+    test_uart.c "$SRC/uart4_tx.c" build/crc_funcs.c
+OUT=$(./build/test_uart) || { echo "$OUT"; exit 1; }
+echo "$OUT" | grep -v '^C_LINE='
+C_LINE=$(echo "$OUT" | sed -n 's/^C_LINE=//p')
+python3 test_parser.py "$C_LINE"
diff --git a/device/tests/test_parser.py b/device/tests/test_parser.py
new file mode 100644
index 0000000..41d6fc1
--- /dev/null
+++ b/device/tests/test_parser.py
@@ -0,0 +1,71 @@
+"""라즈베리파이 Uart_stm.py 의 parse_line 시험. 실제 로그에서 본 손상 모양을 그대로 넣어 본다 (afa-telemetry-sql 분석).
+사용: python3 device/tests/test_parser.py  (make_and_run.sh 가 C 시험 뒤에 부름)"""
+import importlib.util
+import sys
+import types
+from pathlib import Path
+
+# pyserial 없이 import (이 시험은 시리얼 포트를 열지 않는다)
+if "serial" not in sys.modules:
+    try:
+        import serial  # noqa: F401
+    except ImportError:
+        fake = types.ModuleType("serial")
+        fake.Serial, fake.SerialException = None, Exception
+        fake.tools = types.ModuleType("serial.tools")
+        fake.tools.list_ports = types.ModuleType("serial.tools.list_ports")
+        sys.modules.update({"serial": fake, "serial.tools": fake.tools, "serial.tools.list_ports": fake.tools.list_ports})
+spec = importlib.util.spec_from_file_location("uart_stm", Path(__file__).parent.parent / "raspberry pi 5" / "Uart_stm.py")
+u = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(u)
+
+fails = 0
+
+
+def check(cond, msg):
+    global fails
+    print(("통과 " if cond else "실패 ") + msg)
+    fails += not cond
+
+
+n = len(u.SENSOR_KEYS)
+vals = [f"{i + 0.5:.1f}" for i in range(n)]
+good = "342412," + ",".join(vals)
+with_crc = f"{good}*{u.crc8(good):02X}"
+
+s = u.parse_line(with_crc + "\n")
+check(s is not None and s["stm_ms"] == 342412 and s[u.SENSOR_KEYS[-1]] == float(vals[-1]), "CRC 맞는 줄은 값 그대로")
+check(u.parse_line(good + "\n") is not None, "CRC 없는 줄(예전 펌웨어)도 칸 수가 맞으면 받음")
+
+# 실제 로그에서 본 손상 1: 숫자 한 글자가 빠짐 (44.4 -> 4.4). CRC가 있으면 잡힌다
+bad = with_crc.replace(",5.5,", ",.5,", 1)
+check(u.parse_line(bad) is None and u.last_reject_reason == "crc", "숫자 한 글자가 빠진 줄은 CRC로 버림")
+
+# 손상 2: 칸 하나가 빠짐 -> 예전엔 끝을 '0'으로 채워 저장 (그래서 can2 = 0)
+missing = "342412," + ",".join(vals[:5] + vals[6:])
+check(u.parse_line(missing) is None and u.last_reject_reason == "fields", "칸이 하나 빠진 줄은 0으로 채우지 않고 버림")
+
+# 손상 3: 버퍼가 차서 반쪽 줄 + 다음 줄이 붙음 -> 예전엔 잘라서 저장
+merged = "342412," + ",".join(vals[:20]) + "342422," + ",".join(vals)
+check(u.parse_line(merged) is None, "두 줄이 붙은 줄은 자르지 않고 버림")
+
+# 예전 펌웨어 형식(칸 수가 정해진 짧은 형식)은 그대로 받는다
+legacy = "342412," + ",".join(vals[: len(u.LEGACY_SENSOR_KEYS)])
+s = u.parse_line(legacy)
+check(s is not None and s[u.SENSOR_KEYS[-1]] == 0.0, "예전 펌웨어 짧은 형식은 받고 뒤를 0으로 채움 (전과 같음)")
+
+# C 쪽과 같은 CRC
+check(u.crc8("123456789") == 0xF4, "CRC-8 표준 검사값 123456789 -> F4")
+if len(sys.argv) > 1:                                   # make_and_run.sh 가 C 시험이 만든 줄을 넘겨줌
+    c_line = sys.argv[1]
+    check(u.parse_line(c_line) is not None or u.last_reject_reason != "crc",
+          f"C가 만든 줄의 CRC를 파이썬이 같은 값으로 검사 ({c_line.strip()})")
+
+# 깨진 바이트는 조용히 지우지 않는다
+try:
+    b"342412,4\xb4.4".decode("ascii", errors="strict")
+    check(False, "깨진 바이트 거절")
+except UnicodeDecodeError:
+    check(True, "깨진 바이트(0x80 이상)가 든 줄은 디코드 단계에서 거절 (예전 errors='ignore'는 지워서 44.4 -> 4.4)")
+
+sys.exit(1 if fails else 0)
