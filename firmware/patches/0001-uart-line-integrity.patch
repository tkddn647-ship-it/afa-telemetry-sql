+++ b/device/ECU_test/Core/Src/uart4_tx.c
@@ -71,18 +71,21 @@ uint8_t Uart4Tx_Write(const uint8_t *data, uint16_t len)
   }
 
   __disable_irq();
+  /* 한 줄을 통째로 넣거나 통째로 버린다 (2026-11 수정).
+   * 예전에는 버퍼가 차면 줄의 앞부분만 넣고 멈춰서, 줄바꿈 없는 반쪽 줄이 다음 줄과 붙어 전송됐다.
+   * 수신 쪽에서는 칸이 밀린 한 줄 + 빠진 샘플로 보였다 (afa-telemetry-sql 분석, 오후1차 8318행 등).
+   * 링버퍼는 head == tail 을 '빔'으로 쓰므로 실제로 넣을 수 있는 양은 SIZE - 1 - used. */
+  if ((uint32_t)len > (uint32_t)(UART4_TX_RING_SIZE - 1U - Uart4Tx_UsedLocked()))
+  {
+    uart4_tx_overflow++;
+    __enable_irq();
+    Uart4Tx_Kick();
+    return 0U;
+  }
   for (i = 0U; i < len; i++)
   {
-    uint16_t next = Uart4Tx_NextIndex(uart4_tx_head);
-    if (next == uart4_tx_tail)
-    {
-      uart4_tx_overflow++;
-      __enable_irq();
-      Uart4Tx_Kick();
-      return 0U;
-    }
     uart4_tx_ring[uart4_tx_head] = data[i];
-    uart4_tx_head = next;
+    uart4_tx_head = Uart4Tx_NextIndex(uart4_tx_head);
   }
   __enable_irq();
 
