@@ -425,6 +425,47 @@ static void SensorUart_CaptureSample(void)
   data_count++;
 }
 
+/* CRC-8 (다항식 0x07, 초기값 0). 줄 끝 '*HH' 로 붙여 수신 쪽이 손상된 줄을 버릴 수 있게 한다 (2026-11 추가).
+ * 라즈베리파이 Uart_stm.py 의 crc8() 과 같은 계산. */
+uint8_t SensorUart_Crc8(const char *s, int len)
+{
+  uint8_t crc = 0U;
+  int i;
+  int b;
+
+  for (i = 0; i < len; i++)
+  {
+    crc ^= (uint8_t)s[i];
+    for (b = 0; b < 8; b++)
+    {
+      if ((crc & 0x80U) != 0U)
+      {
+        crc = (uint8_t)((uint8_t)(crc << 1U) ^ 0x07U);
+      }
+      else
+      {
+        crc = (uint8_t)(crc << 1U);
+      }
+    }
+  }
+  return crc;
+}
+
+/* FormatSample 이 만든 "...\n" 을 "...*HH\n" 으로 바꾼다. 자리가 없으면 0 (보내지 않음). */
+int SensorUart_AppendCrc(char *line, int len, int cap)
+{
+  uint8_t crc;
+
+  if ((len <= 0) || (line[len - 1] != '\n') || (len + 3 >= cap))
+  {
+    return 0;
+  }
+  len--;                                   /* 줄바꿈을 잠시 뺀다 */
+  crc = SensorUart_Crc8(line, len);
+  len += snprintf(&line[len], (size_t)(cap - len), "*%02X\n", (unsigned int)crc);
+  return len;
+}
+
 static void SensorUart_SendSample(const SensorSample_t *sample)
 {
   char line[512];
@@ -435,6 +476,12 @@ static void SensorUart_SendSample(const SensorSample_t *sample)
   {
     return;
   }
+  len = SensorUart_AppendCrc(line, len, (int)sizeof(line));
+  if (len <= 0)
+  {
+    sensor_uart_overflow++;
+    return;
+  }
 
   if (Uart4Tx_Write((const uint8_t *)line, (uint16_t)len) != 0U)
   {
@@ -482,10 +529,12 @@ static void SensorUart_SendHeartbeat(void)
   len = snprintf(
       line,
       sizeof(line),
-      "HB,%lu,%lu,%u\n",
+      "HB,%lu,%lu,%u,%lu,%lu\n",            /* 뒤 두 칸: 버린 줄 수 (2026-11 추가, 예전엔 세기만 하고 안 보냄) */
       (unsigned long)HAL_GetTick(),
       (unsigned long)lws.rx_count,
-      (unsigned int)lws.cal);
+      (unsigned int)lws.cal,
+      (unsigned long)sensor_uart_overflow,
+      (unsigned long)uart4_tx_overflow);
   if (len > 0)
   {
     (void)Uart4Tx_Write((const uint8_t *)line, (uint16_t)len);
diff --git a/device/ECU_test/Core/Src/uart4_tx.c b/device/ECU_test/Core/Src/uart4_tx.c
