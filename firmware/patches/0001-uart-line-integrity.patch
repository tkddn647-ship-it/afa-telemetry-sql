+/* UART 전송 코드 시험 (호스트에서). make_and_run.sh 가 컴파일한다. */
+#include <stdio.h>
+#include <string.h>
+#include "usart.h"
+#include "uart4_tx.h"
+
+uint8_t SensorUart_Crc8(const char *s, int len);
+int SensorUart_AppendCrc(char *line, int len, int cap);
+
+UART_HandleTypeDef huart4 = { UART4 };
+static int dma_calls = 0;
+int HAL_UART_Transmit_DMA(UART_HandleTypeDef *h, uint8_t *d, uint16_t n) { (void)h; (void)d; (void)n; dma_calls++; return HAL_OK; }
+int HAL_UART_AbortTransmit(UART_HandleTypeDef *h) { (void)h; return HAL_OK; }
+
+static int fails = 0;
+#define CHECK(cond, msg) do { if (cond) printf("통과 %s\n", msg); else { printf("실패 %s\n", msg); fails++; } } while (0)
+
+int main(void)
+{
+    char line[64];
+    uint8_t chunk[600];
+    int i;
+
+    /* 1. 버퍼가 차 있으면 줄을 통째로 버린다 (반쪽 줄을 넣지 않는다).
+     *    DMA 완료 콜백을 부르지 않으므로 보낸 바이트가 버퍼에서 안 빠진다 = 가득 찬 상태를 만들 수 있다. */
+    Uart4Tx_Init();
+    memset(chunk, 'x', sizeof(chunk));
+    for (i = 0; i < 7; i++) Uart4Tx_Write(chunk, 512);           /* 3584 바이트 */
+    uint16_t before = Uart4Tx_Pending();
+    uint32_t ov_before = uart4_tx_overflow;
+    uint8_t ok = Uart4Tx_Write(chunk, 600);                       /* 남은 자리 511보다 큼 */
+    CHECK(ok == 0U && Uart4Tx_Pending() == before && uart4_tx_overflow == ov_before + 1U,
+          "버퍼보다 긴 줄은 한 바이트도 넣지 않고 버리고, 버린 수를 센다");
+    ok = Uart4Tx_Write(chunk, 511);
+    CHECK(ok == 1U && Uart4Tx_Pending() == before + 511U, "딱 맞는 줄(남은 자리 511)은 들어간다");
+    ok = Uart4Tx_Write(chunk, 1);
+    CHECK(ok == 0U && Uart4Tx_Pending() == 4095U, "가득 차면 1바이트도 안 들어간다 (head==tail 은 '빔'이라 4095가 최대)");
+
+    /* 2. CRC: 알려진 값 (CRC-8/SMBUS, '123456789' -> 0xF4) */
+    CHECK(SensorUart_Crc8("123456789", 9) == 0xF4, "CRC-8 표준 검사값 123456789 -> F4");
+
+    /* 3. 줄 끝에 *HH 붙이기 */
+    strcpy(line, "342412,8.82,-1.49\n");
+    int n = SensorUart_AppendCrc(line, (int)strlen(line), (int)sizeof(line));
+    char want[16];
+    snprintf(want, sizeof(want), "*%02X\n", SensorUart_Crc8("342412,8.82,-1.49", 17));
+    CHECK(n == (int)strlen(line) && strcmp(line + n - 4, want) == 0, "줄 끝이 '*HH\\n' 형식");
+    printf("C_LINE=%s", line);                                    /* 파이썬 시험이 같은 CRC를 내는지 비교 */
+    strcpy(line, "no newline");
+    CHECK(SensorUart_AppendCrc(line, 10, (int)sizeof(line)) == 0, "줄바꿈 없는 줄은 보내지 않음");
+
+    return fails ? 1 : 0;
+}
