     fail(f"UART 열기 실패: {last_exc}")
 
 
+KNOWN_VALUE_LENGTHS = (len(LEGACY_SENSOR_KEYS), len(SENSOR_KEYS_WITH_TEMP), len(SENSOR_KEYS_WITH_STEERING), len(SENSOR_KEYS))
+last_reject_reason = ""   # 마지막으로 버린 줄의 이유 (통계용)
+
+
+def crc8(text: str) -> int:
+    """STM32 sensor_uart.c 의 SensorUart_Crc8 과 같은 CRC-8 (다항식 0x07, 초기값 0)."""
+    crc = 0
+    for ch in text.encode("ascii"):
+        crc ^= ch
+        for _ in range(8):
+            crc = ((crc << 1) ^ 0x07) & 0xFF if crc & 0x80 else (crc << 1) & 0xFF
+    return crc
+
+
 def parse_line(line: str) -> dict[str, Any] | None:
-    """UART 한 줄을 센서 샘플 dict 로 변환."""
-    parts = [p.strip() for p in line.strip().split(",")]
+    """UART 한 줄을 센서 샘플 dict 로 변환. 손상된 줄은 None (2026-11 수정).
+
+    예전에는 칸 수가 모자라면 '0'으로 채우고 남으면 잘라서, 두 줄이 붙거나 칸이 빠진 줄도 샘플로 저장됐다
+    (afa-telemetry-sql 분석: 한 줄 전체 손상 67행 중 56행이 마지막 칸 can2 = 0). 지금은:
+      - 줄 끝 '*HH' (CRC-8) 가 있으면 검사하고, 틀리면 버린다. 없는 줄(예전 펌웨어)은 칸 수 검사만.
+      - 칸 수는 알려진 형식(예전 펌웨어 포함) 중 하나와 정확히 같아야 한다. 예전 형식만 뒤 칸을 '0'으로 채운다.
+    """
+    global last_reject_reason
+    text = line.strip()
+    if len(text) > 3 and text[-3] == "*":
+        body, given = text[:-3], text[-2:]
+        try:
+            ok = int(given, 16) == crc8(body)
+        except (ValueError, UnicodeEncodeError):
+            ok = False
+        if not ok:
+            last_reject_reason = "crc"
+            return None
+        text = body
+    parts = [p.strip() for p in text.split(",")]
     if len(parts) < len(LEGACY_SENSOR_KEYS):
+        last_reject_reason = "fields"
         return None
 
+    # 첫 칸이 MCU 시각인지는 칸 수가 아니라 모양으로 판단한다. 시각은 정수(%lu), 첫 센서 값 FR 은 항상 소수점이 있다(%ld.%02ld).
+    # 칸 수로 판단하면 칸 하나가 빠진 줄이 '시각 없는 예전 형식'과 칸 수가 같아져 그대로 받아들여진다.
     stm_ms: int | None = None
     values: list[str]
-    if len(parts) >= len(LEGACY_SENSOR_KEYS) + 1:
-        try:
-            stm_ms = int(float(parts[0]))
-            values = parts[1:]
-        except ValueError:
-            values = parts
+    if parts[0].isdigit():
+        stm_ms = int(parts[0])
+        values = parts[1:]
     else:
         values = parts
+    if len(values) not in KNOWN_VALUE_LENGTHS:
+        last_reject_reason = "fields"       # 칸이 빠지거나 두 줄이 붙은 줄: 채우거나 자르지 않고 버림
+        return None
 
     if len(values) < len(SENSOR_KEYS):
-        values = [*values, *("0",) * (len(SENSOR_KEYS) - len(values))]
-    elif len(values) > len(SENSOR_KEYS):
-        values = values[: len(SENSOR_KEYS)]
+        values = [*values, *("0",) * (len(SENSOR_KEYS) - len(values))]   # 예전 펌웨어 형식만 여기에 옴
 
     try:
         nums = [float(v) for v in values]
     except ValueError:
+        last_reject_reason = "number"
         return None
 
     sample: dict[str, Any] = {
@@ -476,6 +513,7 @@ def read_loop(
     ser: serial.Serial,
     stop_event: threading.Event,
 ) -> None:
+    global last_reject_reason
     while not stop_event.is_set():
         try:
             raw = ser.readline()
@@ -486,8 +524,11 @@ def read_loop(
             continue
         uart_stats.on_bytes(len(raw))
         try:
-            line = raw.decode("ascii", errors="ignore")
+            # errors="ignore" 였을 때는 깨진 바이트가 조용히 지워져 숫자 한 글자가 빠진 값(44.4 -> 4.4)으로 저장됐다 (2026-11 수정)
+            line = raw.decode("ascii", errors="strict")
         except UnicodeDecodeError:
+            last_reject_reason = "decode"
+            uart_stats.on_line(raw.decode("ascii", errors="replace"), None)
             continue
         if is_boot_line(line):
