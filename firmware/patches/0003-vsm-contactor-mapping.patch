 python3 test_parser.py "$C_LINE"
+
+# can_vehicle.c 에서 VSM 매핑 함수만 떼어 온다
+python3 - "$SRC/can_vehicle.c" > build/vsm_func.c <<'P'
+import sys
+s = open(sys.argv[1], encoding="utf-8").read()
+i = s.index("static void CAN_Vehicle_MotorStatusFromVsm("); j = s.index("\n}\n", i) + 3
+print(s[i:j])
+P
+gcc -std=c99 -Wall -Wextra -Werror -I build -o build/test_vsm test_vsm.c
+./build/test_vsm
