diff --git a/device/tests/test_vsm.c b/device/tests/test_vsm.c
new file mode 100644
index 0000000..f1b841d
--- /dev/null
+++ b/device/tests/test_vsm.c
@@ -0,0 +1,25 @@
+/* VSM 상태 -> 프리차지 / 메인 접촉기 매핑 시험 (CAN Protocol V5.9 0x0AA Byte0). */
+#include <stdint.h>
+#include <stdio.h>
+#include "vsm_func.c"
+
+int main(void)
+{
+  /* 기대값: {vsm, precharge, contactor} */
+  static const uint8_t want[][3] = {
+    {0, 0, 0}, {1, 1, 0}, {2, 1, 0}, {3, 0, 1}, {4, 0, 1}, {5, 0, 1}, {6, 0, 1},
+    {7, 0, 0}, {14, 0, 0}, {15, 0, 0}, {255, 0, 0},
+  };
+  int fail = 0;
+  for (unsigned i = 0; i < sizeof(want) / sizeof(want[0]); i++) {
+    uint8_t pre = 9, mc = 9;
+    CAN_Vehicle_MotorStatusFromVsm(want[i][0], &pre, &mc);
+    if (pre != want[i][1] || mc != want[i][2]) {
+      printf("FAIL vsm=%u: precharge=%u contactor=%u (want %u %u)\n", want[i][0], pre, mc, want[i][1], want[i][2]);
+      fail = 1;
+    }
+  }
+  /* 초기충전 중(2)에는 절대 '닫힘'이 아니어야 한다 — 2026-08-11 로그 결함의 직접 원인 */
+  printf(fail ? "VSM 매핑 실패\n" : "OK  VSM 매핑 11개 상태 (2 = 초기충전 중은 닫힘 아님)\n");
+  return fail;
+}
