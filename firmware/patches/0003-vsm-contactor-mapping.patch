diff --git a/device/ECU_test/Core/Src/can_vehicle.c b/device/ECU_test/Core/Src/can_vehicle.c
index eaafed0..11d5fca 100644
--- a/device/ECU_test/Core/Src/can_vehicle.c
+++ b/device/ECU_test/Core/Src/can_vehicle.c
@@ -329,35 +329,27 @@ static void CAN_Vehicle_ParseInvVoltage(const uint8_t *data, uint8_t dlc)
   mc->last_rx_ms = HAL_GetTick();
 }
 
+/*
+ * Cascadia VSM state (0x0AA Byte0) -> precharge / main contactor.
+ * CAN Protocol V5.9: 0 Start, 1 Pre-charge Init, 2 Pre-charge Active, 3 Pre-charge Complete,
+ *                    4 Wait, 5 Ready, 6 Motor Running, 7 Blink Fault Code, 14 Shutdown, 15 Recycle Power.
+ * 전에는 2(초기충전 중)부터 main_contactor_closed = 1 이라, 로그의 '접촉기 닫힘' 순간이 실제로는 초기충전 시작이었다
+ * (2026-08-11 로그: 그 순간 인버터 전압이 팩의 16%, 전류 0 A 로 약 920 ms 동안 90% 까지 상승).
+ * ESP32 시험 코드(esp32_motor_can.ino)와 같은 매핑으로 맞춘다. 고장·종료 상태(7, 14, 15 등)는 닫힘으로 보지 않는다.
+ * 주의: 이 값은 여전히 VSM 상태에서 추정한 것이다. 실제 AIR 상태가 필요하면 Byte3 Relay State 를 따로 기록할 것.
+ */
+static void CAN_Vehicle_MotorStatusFromVsm(uint8_t vsm_state, uint8_t *precharge_active, uint8_t *main_contactor_closed)
+{
+  *precharge_active = (uint8_t)(vsm_state == 1U || vsm_state == 2U);
+  *main_contactor_closed = (uint8_t)(vsm_state >= 3U && vsm_state <= 6U);
+}
+
 static void CAN_Vehicle_UpdateMotorStatusFromVsm(uint8_t vsm_state)
 {
   CanMotorState_t *mc = &vehicle_state.motor;
 
   mc->vsm_state = vsm_state;
-
-  /*
-   * Cascadia VSM state (0x0AA Byte0) — precharge / main contactor 추정.
-   * Torque/Speed(Run Mode)는 Byte4 에서 별도 파싱.
-   */
-  switch (vsm_state)
-  {
-    case 0U:
-      mc->precharge_active = 0U;
-      mc->main_contactor_closed = 0U;
-      break;
-    case 1U:
-      mc->precharge_active = 1U;
-      mc->main_contactor_closed = 0U;
-      break;
-    case 2U:
-      mc->precharge_active = 0U;
-      mc->main_contactor_closed = 1U;
-      break;
-    default:
-      mc->precharge_active = (uint8_t)(vsm_state == 1U);
-      mc->main_contactor_closed = (uint8_t)(vsm_state >= 2U);
-      break;
-  }
+  CAN_Vehicle_MotorStatusFromVsm(vsm_state, &mc->precharge_active, &mc->main_contactor_closed);
 }
 
 static void CAN_Vehicle_ParseInvStatus(const uint8_t *data, uint8_t dlc)
diff --git a/device/tests/make_and_run.sh b/device/tests/make_and_run.sh
